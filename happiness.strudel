setcpm(200);


const chords = [
    `<- d#3, -@1.1 a#3@0.9, -@1.2 d#4@0.8, -@1.3 f4@0.7>`, //downward strum
    `<- f4, -@1.1 d#4@0.9, -@1.2 a#3@0.8, -@1.3 d#3@0.7>`, //upward strum
    `<- d#3, -@1.1 a#3@0.9, -@1.2 d#4@0.8, -@1.3 g4@0.7>`, //downward strum
    `<- d#3, -@1.1 a#3@0.9, -@1.2 d#4@0.8, -@1.3 g#4@0.7>`, //downward strum
]

$: arrange(
    [2, chords[0]],
    [2, chords[1]],
    [2, chords[0]],
    [2, chords[1]],
    [2, chords[2]],
    [2, chords[1]],
    [2, chords[0]],
    [2, chords[1]],
    [2, chords[3]],
    [2, chords[1]],
).note().sound("gm_acoustic_guitar_nylon")