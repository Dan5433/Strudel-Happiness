setcpm(200);


const chords = [
    `<- d#3, -@1.1 a#3@0.9, -@1.2 d#4@0.8, -@1.3 f4@0.7>`, //downward strum
    `<- f4, -@1.1 d#4@0.9, -@1.2 a#3@0.8, -@1.3 d#3@0.7>*2`, //upward strum
    `<- d#3, -@1.1 a#3@0.9, -@1.2 d#4@0.8, -@1.3 g4@0.7>`, //downward strum
    `<- d#3, -@1.1 a#3@0.9, -@1.2 d#4@0.8, -@1.3 g#4@0.7>`, //downward strum

    `<- c#3, -@1.1 f3@0.9, -@1.2 g#3@0.8, -@1.3 c#4@0.7, -@1.4 f4@0.6>`, //downward strum
    `<- f4, -@1.1 c#4@0.9, -@1.2 g#3@0.8, -@1.3 f3@0.7, -@1.4 c#3@0.6>*2`, //upward strum
    `<- c#3, -@1.1 f3@0.9, -@1.2 g#3@0.8, -@1.3 c4@0.7, -@1.4 f4@0.6>`, //downward strum
    `<- c#3, -@1.1 f3@0.9, -@1.2 g#3@0.8, -@1.3 d#4@0.7, -@1.4 f4@0.6>`, //downward strum

    `<- g#2, -@1.1 c3@0.9, -@1.2 d#3@0.8, -@1.3 g#3@0.7, -@1.4 d#4@0.6, -@1.5 g#4@0.5>`, //downward strum
    `<- g#4, -@1.1 d#4@0.9, -@1.2 g#3@0.8, -@1.3 d#3@0.7, -@1.4 c3@0.6, -@1.5 g#2@0.5>*2`, //upward strum
    `<- g#2, -@1.1 c3@0.9, -@1.2 d#3@0.8, -@1.3 g#3@0.7, -@1.4 c4@0.6, -@1.5 f4@0.5>`, //downward strum
]

$: arrange(
    [2, chords[0]],
    [1, chords[1]],
    [2, chords[0]],
    [1, chords[1]],
    [2, chords[2]],
    [1, chords[1]],
    [2, chords[0]],
    [1, chords[1]],
    [2, chords[3]],
    [1, chords[1]],
    [1, "-"],
    [2, chords[0]],
    [1, chords[1]],
    [2, chords[0]],
    [1, chords[1]],
    [2, chords[2]],
    [1, chords[1]],
    [2, chords[0]],
    [1, chords[1]],
    [2, chords[3]],
    [1, chords[1]],
    [1, "-"],
    
    [2, chords[4]],
    [1, chords[5]],
    [2, chords[4]],
    [1, chords[5]],
    [2, chords[6]],
    [1, chords[5]],
    [2, chords[4]],
    [1, chords[5]],
    [2, chords[7]],
    [1, chords[5]],
    [1, "-"],
    [2, chords[4]],
    [1, chords[5]],
    [2, chords[4]],
    [1, chords[5]],
    [2, chords[6]],
    [1, chords[5]],
    [2, chords[4]],
    [1, chords[5]],
    [2, chords[7]],
    [1, chords[5]],
    [1, "-"],

    [2, chords[8]],
    [1, chords[9]],
    [2, chords[8]],
    [1, chords[9]],
    [2, chords[10]],
    [1, chords[9]],
    [2, chords[8]],
    [1, chords[9]],
    [2, chords[10]],
    [1, chords[9]],
    [1, "-"],
    [2, chords[8]],
    [1, chords[9]],
    [2, chords[8]],
    [1, chords[9]],
    [2, chords[10]],
    [1, chords[9]],
    [2, chords[8]],
    [1, chords[9]],
    [2, chords[10]],
    [1, chords[9]],
    [1, "-"],
).note().sound("gm_acoustic_guitar_nylon").release(2)


const melody = `<
f4 d#4 a#3 d#3 -
g4 d#4 a#3 d#3 -
g#4 d#4 a#3 d#3 -
-
f4 d#4 a#3 d#3 -
g4 d#4 a#3 d#3 -
g#4 d#4 a#3 d#3 -
-
c#4 g#3 f3 c#3 -
c4 g#3 f3 c#3 -
d#4 g#3 f3 c#3 -
-
c#4 g#3 f3 c#3 -
c4 g#3 f3 c#3 -
d#4 g#3 f3 c#3 -
-
g#4 d#4 g#3 d#3 -
f4 c4 a#3 d#3 -
f4 c4 a#3 d#3 -
-
g#4 d#4 g#3 d#3 -
f4 c4 a#3 d#3 -
f4 c4 a#3 d#3 -
-
>`;
$: arrange(
    [16*6, "-"],
    [16*6, melody],
).note().sound("piano").release(1).gain("0.6".pow(2))


const drums = `
<bd>
,
<- sd>
`;
$: arrange(
    [16*6*2, "-"],
    [16*6, drums.slow(2)],
).sound().gain("0.4".pow(2))


const bass = `<
d#2 c#2 g#2
>/1.5`
$: note(bass).sound("gm_acoustic_bass:1").gain("0.7".pow(2))